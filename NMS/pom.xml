<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>pl.kiosel.toastapi</groupId>
        <artifactId>toastapi-parent</artifactId>
        <version>1.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <packaging>pom</packaging>
    <artifactId>toastapi-nms-parent</artifactId>

    <modules>
        <!--NMS-->
        <module>NMS</module>

        <module>NMS-API</module>

        <module>NMS-v1_16_R3</module>
        <module>NMS-v1_17_R1</module>
        <module>NMS-v1_18_R1</module>
        <module>NMS-v1_18_R2</module>
        <module>NMS-v1_19_R1</module>
        <module>NMS-v1_19_R2</module>
        <module>NMS-v1_19_R3</module>
        <module>NMS-v1_20_R1</module>
        <module>NMS-v1_20_R2</module>
        <module>NMS-v1_20_R3</module>
        <module>NMS-v1_20_R4</module>
        <module>NMS-v1_21_R1</module>
        <module>NMS-v1_21_R2</module>
        <module>NMS-v1_21_R3</module>
        <module>NMS-v1_21_R4</module>
        <module>NMS-v1_21_R5</module>
        <module>NMS-v1_21_R6</module>
        <module>NMS-v1_21_R7</module>
        <module>NMS-v26_1_R1</module>
        <module>NMS-v26_2_R1</module>
        <module>NMS-v26_3_R1</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <java.version>16</java.version>
        <java.release>16</java.release>

        <maven.compiler.source>16</maven.compiler.source>
        <maven.compiler.target>16</maven.compiler.target>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>net.md-5</groupId>
                    <artifactId>specialsource-maven-plugin</artifactId>
                    <version>2.0.4</version>
                    <executions>
                        <execution>
                            <id>mojang-to-obfuscated</id>
                            <phase>package</phase>
                            <goals>
                                <goal>remap</goal>
                            </goals>
                            <configuration>
                                <!--suppress UnresolvedMavenProperty -->
                                <srgIn>org.spigotmc:minecraft-server:${nms.server.version}:txt:maps-mojang</srgIn>
                                <reverse>true</reverse>
                                <!--suppress UnresolvedMavenProperty -->
                                <remappedDependencies>org.spigotmc:spigot:${nms.server.version}:jar:remapped-mojang
                                </remappedDependencies>
                                <remappedArtifactAttached>true</remappedArtifactAttached>
                                <remappedClassifierName>remapped-obf</remappedClassifierName>
                            </configuration>
                        </execution>
                        <execution>
                            <id>obfuscated-to-spigot</id>
                            <phase>package</phase>
                            <goals>
                                <goal>remap</goal>
                            </goals>
                            <configuration>
                                <inputFile>${project.build.directory}/${project.build.finalName}-remapped-obf.jar
                                </inputFile>
                                <!--suppress UnresolvedMavenProperty -->
                                <srgIn>org.spigotmc:minecraft-server:${nms.server.version}:csrg:maps-spigot</srgIn>
                                <!--suppress UnresolvedMavenProperty -->
                                <remappedDependencies>org.spigotmc:spigot:${nms.server.version}:jar:remapped-obf
                                </remappedDependencies>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
